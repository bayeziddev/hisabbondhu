{
  "name": "hisabbondhu-api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "HisabBondhu sync & auth API on Cloudflare Workers + D1 + R2 + Queues",
  "scripts": {
    "dev": "wrangler dev --local",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "e2e": "node scripts/e2e.mjs",
    "db:migrate:local": "wrangler d1 migrations apply hisabbondhu --local",
    "db:migrate:remote": "wrangler d1 migrations apply hisabbondhu --remote",
    "check:api": "node scripts/check-api.mjs"
  },
  "dependencies": {
    "hono": "^4.13.19",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261119.1",
    "@types/node": "^22.20.5",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7",
    "wrangler": "^4.165.0"
  }
}
