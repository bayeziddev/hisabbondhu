<?xml version="1.0" encoding="utf-8"?>
<!-- Financial data and login tokens must not leave the device through Android cloud backup or
     device-to-device transfer. HisabBondhu has its own encrypted (HTTPS) backup for logged-in users. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
