<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.HisabBondhu" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:windowBackground">@color/paper</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="colorPrimary">@color/brand_green</item>
        <item name="colorAccent">@color/brand_blue</item>
    </style>

    <style name="Theme.HisabBondhu.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/brand_green</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.HisabBondhu</item>
    </style>
</resources>
